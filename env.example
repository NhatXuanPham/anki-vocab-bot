# Telegram Bot Token - @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI-compatible chat completions endpoint
AI_API_URL=http://localhost:4000/v1/chat/completions
AI_MODEL=gemini/gemini-3.5-flash
AI_API_KEY=sk-1234

# AnkiConnect
ANKI_CONNECT_URL=http://host.docker.internal:8765
#ANKI_CONNECT_URL=http://localhost:8765

# Deck name and note type in Anki
ANKI_DECK_NAME=Vocab AI
ANKI_MODEL_NAME=Vocab (AI)

# (Optional) Allow only these Telegram users to use the bot, separated by commas
# Leave blank if anyone can use it (not recommended if the bot is public)
ALLOWED_TELEGRAM_USER_IDS=
