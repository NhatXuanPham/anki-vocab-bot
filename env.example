# Telegram Bot Token - lấy từ @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq API Key - lấy từ https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Gemini API Key - lấy từ https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Cohere API Key - lấy từ https://cohere.com/
COHERE_API_KEY=your_cohere_api_key_here

# Tên model Groq muốn dùng
GROQ_MODEL=llama-3.3-70b-versatile

# Tên model Gemini muốn dùng
GEMINI_MODEL=gemini/gemini-3.5-flash

# Tên model Cohere muốn dùng
COHERE_MODEL=command-a-03-2025

# AnkiConnect (mặc định addon chạy ở cổng 8765 trên máy đang mở Anki)
ANKI_CONNECT_URL=http://127.0.0.1:8765

# Tên deck và note type sẽ dùng trong Anki
ANKI_DECK_NAME=Vocab AI
ANKI_MODEL_NAME=Vocab (AI)

# (Tuỳ chọn) chỉ cho phép các user Telegram này dùng bot, cách nhau bởi dấu phẩy
# Để trống nếu ai cũng dùng được (không khuyến khích nếu bot public)
ALLOWED_TELEGRAM_USER_IDS=

# LiteLLM configuration (OpenAI-compatible chat completions endpoint)
LITELLM_MODEL=AI-FREE-DAILY
LITELLM_API_URL=http://localhost:4000/v1/chat/completions
# LiteLLM proxy master/virtual key (must start with sk- if proxy auth is enabled)
LITELLM_API_KEY=sk-1234

# AI Provider to use: groq | gemini | cohere | litellm
AI_PROVIDER=groq
