# Telegram Bot Token - lấy từ @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq API Key - lấy từ https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Tên model Groq muốn dùng
GROQ_MODEL=llama-3.3-70b-versatile

# AnkiConnect (mặc định addon chạy ở cổng 8765 trên máy đang mở Anki)
ANKI_CONNECT_URL=http://127.0.0.1:8765

# Tên deck và note type sẽ dùng trong Anki
ANKI_DECK_NAME=Vocab AI
ANKI_MODEL_NAME=Vocab (AI)

# (Tuỳ chọn) chỉ cho phép các user Telegram này dùng bot, cách nhau bởi dấu phẩy
# Để trống nếu ai cũng dùng được (không khuyến khích nếu bot public)
ALLOWED_TELEGRAM_USER_IDS=
